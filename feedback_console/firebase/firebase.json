{
  "functions": [{"source": "functions", "codebase": "feedback-console-slack", "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]}],
  "firestore": {"rules": "firestore.rules"},
  "storage": {"rules": "storage.rules"},
  "hosting": {"public": ".hosting-build", "ignore": ["firebase.json", "**/.*", "**/node_modules/**"], "rewrites": [{"source": "**", "destination": "/index.html"}], "headers": [{"source": "**", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}]},
  "emulators": {"functions": {"port": 5001}, "firestore": {"port": 8080}, "auth": {"port": 9099}}
}
